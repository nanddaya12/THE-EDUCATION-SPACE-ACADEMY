# Development Environment Variables Template

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database Connection
DATABASE_URL="file:./dev.db"

# Redis Cache (Optional)
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET=development_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# File Storage Configuration
STORAGE_PATH=./uploads

# SMTP Email Configuration (Optional)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=dummy_user
SMTP_PASS=dummy_pass
SMTP_SENDER_EMAIL=noreply@educationspace.edu.pk

# SMS Gateway Configuration (Optional)
SMS_GATEWAY_URL=https://api.sms-provider.com/v1/send
SMS_API_KEY=dummy_sms_api_key
SMS_SENDER_ID=EDU_ACADEMY
