# Production Environment Variables Template
# Copy this file to .env on your production server and set actual production secrets

# Server Configuration
PORT=5000
NODE_ENV=production
CLIENT_ORIGIN=https://educationspace.edu.pk
PUBLIC_URL=https://educationspace.edu.pk
CORS_ORIGIN=https://educationspace.edu.pk,https://admin.educationspace.edu.pk

# Database Connection (PostgreSQL Production Instance)
DATABASE_URL="postgresql://erp_user:CHANGE_ME_SECURE_DB_PASSWORD@localhost:5432/educationspace_db?schema=public"

# Redis Cache Cluster (Optional)
REDIS_URL="redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/0"

# JWT Authentication (Use 64+ character random secret key)
JWT_SECRET=CHANGE_ME_HIGH_ENTROPY_PRODUCTION_JWT_SECRET_KEY_64_CHARS
JWT_EXPIRES_IN=7d

# File Storage Configuration
STORAGE_PATH=/var/www/educationspace-erp/uploads

# SMTP Email Configuration
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=CHANGE_ME_SENDGRID_API_KEY
SMTP_SENDER_EMAIL=noreply@educationspace.edu.pk

# SMS Gateway Configuration
SMS_GATEWAY_URL=https://api.sms-provider.com/v1/send
SMS_API_KEY=CHANGE_ME_PRODUCTION_SMS_API_KEY
SMS_SENDER_ID=EDU_ACADEMY

# Frontend API URL Configuration (Vite)
VITE_API_URL=https://educationspace.edu.pk/api/v1
